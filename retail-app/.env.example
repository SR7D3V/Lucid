# Copy to .env.local (development) or set as real environment variables (production).

# Main app connection. In production use a dedicated NON-superuser role that owns the schema.
# Append ?sslmode=require for managed providers (Neon, Supabase, RDS…).
DATABASE_URL=postgres://lucid_app:change-me@localhost:5432/lucid

# Restricted read-only role for the admin SQL console (created by `npm run db:console-role`).
# Leave unset to disable the console.
SQL_CONSOLE_DATABASE_URL=postgres://lucid_console:use-a-long-random-password@localhost:5432/lucid

# Public origin of the site. Required in production: used to build links in emails, and
# state-changing requests must come from this origin.
# APP_ORIGIN=https://lucid.example.com

# Reverse proxies in front of the app that append to X-Forwarded-For (Vercel/Render/Fly/nginx: 1).
# TRUSTED_PROXY_HOPS=1

# Transactional email for password resets (https://resend.com). Without these, development prints
# emails (including reset links) to the terminal running `npm run dev`; production requires them.
# RESEND_API_KEY=re_...
# MAIL_FROM=LUCID <no-reply@your-domain.com>

# Optional: connection pool size per app instance (default 10).
# DATABASE_POOL_SIZE=10

# Used once by `npm run db:seed` to bootstrap the first admin (never modifies an existing account).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use-a-long-unique-password
